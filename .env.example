# Plantilla de variables de entorno de TalentFlow.
# Uso: cp .env.example .env  (y ajustar los valores; .env NO se versiona).
# Si no existe .env, docker-compose.yml usa estos mismos valores por defecto.
# Los valores son solo para desarrollo local.

# --- Base de datos de empleados-service (PostgreSQL) ---
DB_EMPLEADOS_NAME=db_empleados
DB_EMPLEADOS_USER=user_empleados
DB_EMPLEADOS_PASS=pass_empleados

# --- Base de datos de departamentos-service (MySQL) ---
DB_DEPTO_NAME=db_deptos
DB_DEPTO_USER=user_deptos
DB_DEPTO_PASS=pass_deptos
DB_DEPTO_ROOT_PASS=root_pass

# --- Message broker (RabbitMQ) — Reto 4 ---
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# --- Base de datos de notificaciones-service (PostgreSQL) — Reto 4 ---
DB_NOTIF_NAME=db_notificaciones
DB_NOTIF_USER=user_notificaciones
DB_NOTIF_PASS=pass_notificaciones

# --- Base de datos de perfiles-service (PostgreSQL) — Reto 4 ---
DB_PERFILES_NAME=db_perfiles
DB_PERFILES_USER=user_perfiles
DB_PERFILES_PASS=pass_perfiles

# --- Base de datos de vacaciones-service (PostgreSQL) — Reto 4 ---
DB_VACACIONES_NAME=db_vacaciones
DB_VACACIONES_USER=user_vacaciones
DB_VACACIONES_PASS=pass_vacaciones