pipeline {
    agent any

    environment {
        SERVICE_NAME = "auth-service"
        REGISTRY  = "${env.REGISTRY_URL ?: 'localhost:5000'}"
        SONAR_URL = "${env.SONAR_HOST_URL ?: 'http://sonarqube:9000'}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build') {
            steps {
                dir('microservicios/auth-service') {
                    echo 'compilando Go...'
                    sh 'go build ./...'
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/auth-service') {
                    echo 'Ejecutando pruebas y generando coberturas...'
                    sh '''
                        mkdir -p reports
                        
                        if command -v go >/dev/null 2>&1; then
                            # 1. Ejecuta pruebas con verbose y cobertura
                            go test -v -coverprofile=reports/coverage.out ./... > reports/test.log || true

                            # 2. Convierte el log de Go a formato JUnit XML si existe la herramienta
                            if command -v go-junit-report >/dev/null 2>&1 || [ -f "$GOPATH/bin/go-junit-report" ]; then
                                cat reports/test.log | $(command -v go-junit-report || echo "$GOPATH/bin/go-junit-report") > reports/junit.xml || true
                            fi

                            # 3. Convierte el reporte de cobertura a formato Cobertura XML
                            if command -v gocover-cobertura >/dev/null 2>&1 || [ -f "$GOPATH/bin/gocover-cobertura" ]; then
                                $(command -v gocover-cobertura || echo "$GOPATH/bin/gocover-cobertura") < reports/coverage.out > reports/coverage.xml || true
                            fi
                        fi

                        # Fallback en caso de que no se hayan generado los reportes
                        if [ ! -f "reports/junit.xml" ]; then
                            echo '<?xml version="1.0" encoding="UTF-8"?><testsuites></testsuites>' > reports/junit.xml
                        fi
                    '''
                }
            }

            post {
                always {
                    dir('microservicios/auth-service') {
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                        recordCoverage(
                            tools: [[parser: 'COBERTURA', pattern: 'reports/coverage.xml']],
                            sourceCodeRetention: 'EVERY_BUILD'
                        )
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('microservicios/auth-service') {
                    echo 'Ejecutando análisis de SonarQube Scanner nativo...'
                    withSonarQubeEnv('SonarQubeServer') {
                        sh '''
                            if ! command -v unzip >/dev/null 2>&1; then
                                apt-get update && apt-get install -y unzip curl
                            fi

                            if [ ! -d "/tmp/sonar-scanner" ]; then
                                curl -sSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006.zip
                                unzip -q /tmp/sonar-scanner.zip -d /tmp/
                                mv /tmp/sonar-scanner-5.0.1.3006 /tmp/sonar-scanner
                            fi

                            /tmp/sonar-scanner/bin/sonar-scanner \
                              -Dsonar.host.url=${SONAR_HOST_URL} \
                              -Dsonar.sources=. \
                              -Dsonar.tests=. \
                              -Dsonar.test.inclusions=**/*_test.go \
                              -Dsonar.go.coverage.reportPaths=reports/coverage.out
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('microservicios/auth-service') {
                    sh "docker build -t ${SERVICE_NAME}:${BUILD_NUMBER} -t ${SERVICE_NAME}:latest ."
                    echo "✅ Imagen construida: ${SERVICE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('Publish') {
            steps {
                sh """
                    docker tag ${SERVICE_NAME}:${BUILD_NUMBER} ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}
                    docker tag ${SERVICE_NAME}:${BUILD_NUMBER} ${REGISTRY}/${SERVICE_NAME}:latest
                    docker push ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}
                    docker push ${REGISTRY}/${SERVICE_NAME}:latest
                """
                echo "📤 Imagen publicada en registry: ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}"
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ El código compiló pero hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de compilación o del pipeline.'
        }
    }
}