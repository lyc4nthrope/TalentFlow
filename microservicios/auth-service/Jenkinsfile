// Pipeline de auth-service (Reto 7, F3).
// Test ejecuta el mismo comando del Reto 6 y publica las mismas rutas (D14: tabla de
// reportes del README). Una prueba que falla, o la cobertura por debajo del umbral del
// Reto 6, hace fallar Test: el pipeline termina en FAILURE y no empaqueta (D12).
pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

    environment {
        SERVICE_NAME = 'auth-service'
        SERVICE_DIR  = 'microservicios/auth-service'
        // El push lo hace el daemon del host: para él, el registro es localhost:5000.
        REGISTRY     = "${env.REGISTRY_URL ?: 'localhost:5000'}"
        IMAGE        = "${REGISTRY}/${SERVICE_NAME}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir(env.SERVICE_DIR) {
                    sh 'go build ./...'
                }
            }
        }

        stage('Test') {
            steps {
                // make -C microservicios/auth-service test
                sh 'make -C ${SERVICE_DIR} test'
            }
            post {
                always {
                    junit testResults: 'microservicios/auth-service/reports/junit.xml'
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: 'microservicios/auth-service/reports/coverage.xml']],
                        sourceCodeRetention: 'EVERY_BUILD',
                        failOnError: true
                    )
                }
            }
        }

        // SonarQube (F4, D15): el análisis importa el reporte de cobertura de Test; las
        // exclusiones de cobertura son las mismas del Reto 6 (D11/D14), así la cobertura de
        // SonarQube mide la misma lógica de negocio. SONAR_HABILITADO=false salta ambos stages.
        stage('SonarQube') {
            when { environment name: 'SONAR_HABILITADO', value: 'true' }
            steps {
                dir(env.SERVICE_DIR) {
                    withSonarQubeEnv('SonarQubeServer') {
                        sh '''
                        sonar-scanner \\
                          -Dsonar.projectKey=auth-service \\
                          -Dsonar.sources=. \\
                          -Dsonar.exclusions=**/*_test.go,reports/** \\
                          -Dsonar.tests=. \\
                          -Dsonar.test.inclusions=**/*_test.go \\
                          -Dsonar.coverage.exclusions=cmd/**,config/**,internal/api/**,internal/infra/amqp/**,internal/infra/postgres/** \\
                          -Dsonar.go.coverage.reportPaths=reports/coverage-negocio.out
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { environment name: 'SONAR_HABILITADO', value: 'true' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                sh "docker build -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest ${SERVICE_DIR}"
            }
        }

        stage('Publish') {
            steps {
                sh "docker push ${IMAGE}:${BUILD_NUMBER}"
                sh "docker push ${IMAGE}:latest"
            }
        }
    }
}
