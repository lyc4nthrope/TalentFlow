pipeline {
    agent any

    environment {
        SERVICE_NAME = "gestion-empleados"
        REGISTRY  = "${env.REGISTRY_URL ?: 'registry:5000'}"
        SONAR_URL = "${env.SONAR_HOST_URL ?: 'http://sonarqube:9000'}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build') {
            steps {
                dir('microservicios/gestion-empleados') {
                    echo 'Compilando e instalando dependencias...'
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/gestion-empleados') {
                    echo 'Ejecutando pruebas unitarias e integración...'
                    sh 'npm test || true'
                }
            }

            post {
                always {
                    dir('microservicios/gestion-empleados') {
                        junit allowEmptyResults: true, testResults: '**/reports/junit.xml'
                        recordCoverage(
                            tools: [[parser: 'LCOV', pattern: 'reports/lcov.info']],
                            sourceCodeRetention: 'EVERY_BUILD'
                        )
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('microservicios/gestion-empleados') {
                    echo 'Ejecutando análisis de SonarQube...'
                    withSonarQubeEnv('SonarQubeServer') { 
                        sh '''
                            if ! command -v unzip >/dev/null 2>&1; then
                                apt-get update && apt-get install -y unzip
                            fi

                            if [ ! -d "/tmp/sonar-scanner" ]; then
                                curl -sSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006.zip
                                unzip -q /tmp/sonar-scanner.zip -d /tmp/
                                mv /tmp/sonar-scanner-5.0.1.3006 /tmp/sonar-scanner
                            fi
                            
                            /tmp/sonar-scanner/bin/sonar-scanner \
                              -Dsonar.host.url=http://host.docker.internal:9000
                        '''
                    }  
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('microservicios/gestion-empleados') {
                    sh "docker build -t ${SERVICE_NAME}:${BUILD_NUMBER} -t ${SERVICE_NAME}:latest ."
                    echo "✅ Imagen construida: ${SERVICE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('Publish') {
            steps {
                sh """
                    docker tag ${SERVICE_NAME}:${BUILD_NUMBER} ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}
                    docker tag ${SERVICE_NAME}:${BUILD_NUMBER} ${REGISTRY}/${SERVICE_NAME}:latest
                    docker push ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}
                    docker push ${REGISTRY}/${SERVICE_NAME}:latest
                """
                echo "📤 Imagen publicada en registry: ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}"
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ El código compiló pero hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de compilación o del pipeline.'
        }
    }
}