pipeline {
    agent {
        docker {
            image 'php:8.2-cli'
            args '-v php_cache:/root/.cache'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build / Lint') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Instalando extensiones, Composer y verificando sintaxis...'
                    sh '''
                        # 1. Instalar herramientas del sistema y extensiones de PHP
                        apt-get update && apt-get install -y unzip git nodejs npm libzip-dev
                        docker-php-ext-install zip pdo_mysql

                        # 2. Instalar Composer globalmente
                        curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

                        # 3. Instalar dependencias del proyecto (omitiendo la verificación estricta de plataforma si falta algo)
                        composer install --prefer-dist --no-progress --no-interaction --ignore-platform-reqs

                        # 4. Verificar sintaxis PHP
                        find . -name "*.php" -exec php -l {} +
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Ejecutando pruebas unitarias e integración con PHPUnit...'
                    sh '''
                        mkdir -p reports
                        ./vendor/bin/phpunit --log-junit reports/junit.xml --coverage-clover reports/clover.xml || true
                    '''
                }
            }

            post {
                always {
                    dir('microservicios/gestion-departamentos') {
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                        recordCoverage(
                            tools: [[parser: 'CLOVER', pattern: 'reports/clover.xml']],
                            sourceCodeRetention: 'EVERY_BUILD'
                        )
                    }
                }
            }
        }

        stage('Sonarqube') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Ejecutando SonarQube Scanner...'
                    withSonarQubeEnv('SonarQubeServer') {
                        sh 'npx sonarqube-scanner -Dsonar.host.url=http://host.docker.internal:9000'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ Hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de sintaxis, compilación o ejecución en PHP.'
        }
    }
}