pipeline {
    // Usamos una imagen de PHP con CLI que incluya Composer y PCOV/Xdebug
    agent {
        docker {
            image 'php:8.2-cli'
            args '-v php_cache:/root/.cache'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build / Lint') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Verificando sintaxis de archivos PHP...'
                    // Usamos + al final para evitar la barra invertida que rompe Groovy
                    sh 'find . -name "*.php" -exec php -l {} +'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Ejecutando pruebas unitarias e integración con PHPUnit...'

                // Genera el reporte de pruebas y de cobertura directamente con flags de la CLI
                sh './vendor/bin/phpunit --log-junit reports/junit.xml --coverage-clover reports/clover.xml || true'
            }

            post {
                always {
                    // 1. Publica las pruebas en la pestaña "Test Result"
                    junit allowEmptyResults: true, testResults: 'reports/junit.xml'

                    // 2. Publica la cobertura en la pestaña "Coverage"
                    recordCoverage(
                        tools: [[parser: 'CLOVER', pattern: 'reports/clover.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                }
            }
        }

        stage('Sonarqube') {
            environment {
                SONAR_TOKEN = credentials('sonarqube-token')
            }
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Instalando e ejecutando SonarQube Scanner...'
                    sh '''
                        # Instala wget y unzip si no están en el contenedor
                        apt-get update && apt-get install -y wget unzip
                                                        # Descarga sonar-scanner si no existe
                        if [ ! -f "/tmp/sonar-scanner/bin/sonar-scanner" ]; then
                            wget -q https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006-linux.zip -O /tmp/sonar.zip
                            unzip -q /tmp/sonar.zip -d /tmp/
                            mv /tmp/sonar-scanner-* /tmp/sonar-scanner
                        fi
                            
                        /tmp/sonar-scanner/bin/sonar-scanner \
                        -Dsonar.host.url=http://host.docker.internal:9000 \
                        -Dsonar.token=${SONAR_TOKEN}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ Hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de sintaxis, compilación o ejecución en PHP.'
        }
    }
}