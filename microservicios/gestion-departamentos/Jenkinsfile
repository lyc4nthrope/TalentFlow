pipeline {
    agent {
        docker {
            image 'php:8.2-cli'
            args '-v php_cache:/root/.cache'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build / Lint') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Instalando Node.js, PHPUnit y verificando sintaxis...'
                    sh '''
                        # 1. Instalar herramientas necesarias y npx para SonarQube
                        apt-get update && apt-get install -y unzip git nodejs npm curl

                        # 2. Descargar ejecutable de PHPUnit standalone
                        curl -sSL https://phar.phpunit.de/phpunit-10.phar -o /usr/local/bin/phpunit
                        chmod +x /usr/local/bin/phpunit

                        # 3. Verificar sintaxis PHP
                        find . -name "*.php" -exec php -l {} +
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Ejecutando pruebas unitarias con PHPUnit...'
                    sh '''
                        mkdir -p reports
                        # Ejecuta phpunit global si existen pruebas
                        phpunit --log-junit reports/junit.xml || true
                    '''
                }
            }

            post {
                always {
                    dir('microservicios/gestion-departamentos') {
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                    }
                }
            }
        }

        stage('Sonarqube') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Ejecutando SonarQube Scanner...'
                    withSonarQubeEnv('SonarQubeServer') {
                        sh 'npx sonarqube-scanner -Dsonar.host.url=http://host.docker.internal:9000'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ Hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de sintaxis, compilación o ejecución en PHP.'
        }
    }
}