pipeline {
    agent {
        docker {
            image 'php:8.2-cli'
            SERVICE_NAME = "gestion-departamentos"
            args '-v php_cache:/root/.cache'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build / Lint') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Instalando herramientas, Java y verificando sintaxis...'
                    sh '''
                        # 1. Instalar dependencias del sistema y Java nativo (ARM64 compatible)
                        apt-get update && apt-get install -y unzip git curl default-jre

                        # 2. Descargar PHPUnit standalone
                        curl -sSL https://phar.phpunit.de/phpunit-10.phar -o /usr/local/bin/phpunit
                        chmod +x /usr/local/bin/phpunit

                        # 3. Descargar SonarScanner CLI nativo
                        if [ ! -d "/tmp/sonar-scanner" ]; then
                            curl -sSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006.zip
                            unzip -q /tmp/sonar-scanner.zip -d /tmp/
                            mv /tmp/sonar-scanner-5.0.1.3006 /tmp/sonar-scanner
                        fi

                        # 4. Verificar sintaxis PHP
                        find . -name "*.php" -exec php -l {} +
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Ejecutando pruebas unitarias con PHPUnit...'
                    sh '''
                        mkdir -p reports
                        # Especificar la carpeta tests o el archivo phpunit.xml
                        if [ -d "tests" ]; then
                            phpunit --log-junit reports/junit.xml tests || true
                        elif [ -f "phpunit.xml" ]; then
                            phpunit --log-junit reports/junit.xml || true
                        else
                            echo "No se encontraron pruebas unitarias, generando reporte vacío..."
                            echo '<?xml version="1.0" encoding="UTF-8"?><testsuites></testsuites>' > reports/junit.xml
                        fi
                    '''
                }
            }

            post {
                always {
                    dir('microservicios/gestion-departamentos') {
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'
                    }
                }
            }
        }

        stage('Sonarqube') {
            steps {
                dir('microservicios/gestion-departamentos') {
                    echo 'Ejecutando SonarQube Scanner nativo...'
                    withSonarQubeEnv('SonarQubeServer') {
                        sh '''
                            /tmp/sonar-scanner/bin/sonar-scanner \
                              -Dsonar.host.url=http://host.docker.internal:9000 \
                              -Dsonar.sources=.
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        //E2E
        stage('Package') {
            steps {
                script {
                    def imageName = "${SERVICE_NAME}"
                    def imageTag = "${env.BUILD_NUMBER}"
                    sh "docker build -t ${imageName}:${imageTag} -t ${imageName}:latest ."
                    echo "✅ Imagen construida: ${imageName}:${imageTag}"
                }
            }
        }

        stage('Publish') {
            steps {
                script {
                    def imageName = "localhost:5000/${SERVICE_NAME}"
                    def imageTag = "${env.BUILD_NUMBER}"
                    sh "docker tag ${SERVICE_NAME}:${imageTag} ${imageName}:${imageTag}"
                    sh "docker push ${imageName}:${imageTag}"
                    echo "📤 Imagen publicada en registry: ${imageName}:${imageTag}"
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ Hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de sintaxis, compilación o ejecución en PHP.'
        }
    }
}