// Pipeline de gestion-departamentos (Reto 7, F3; pruebas desde el proyecto final, F1).
// Test corre PHPUnit dentro de Docker (`make test`, etapa `reportes` del Dockerfile) y publica
// reports/junit.xml y reports/clover.xml. Una prueba que falla, o la cobertura de líneas de
// src/ por debajo del 70 %, hace fallar Test: el pipeline termina en FAILURE y no empaqueta.
pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

    environment {
        SERVICE_NAME = 'gestion-departamentos'
        SERVICE_DIR  = 'microservicios/gestion-departamentos'
        // El push lo hace el daemon del host: para él, el registro es localhost:5000.
        REGISTRY     = "${env.REGISTRY_URL ?: 'localhost:5000'}"
        IMAGE        = "${REGISTRY}/${SERVICE_NAME}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                // php -l de cada archivo: un error de sintaxis detiene el pipeline.
                dir(env.SERVICE_DIR) {
                    sh 'find . -name "*.php" -not -path "./vendor/*" -print0 | xargs -0 -n1 php -l'
                }
            }
        }

        stage('Test') {
            steps {
                // make -C microservicios/gestion-departamentos test
                sh 'make -C ${SERVICE_DIR} test'
            }
            post {
                always {
                    // allowEmptyResults: si el build de Docker no llega a correr PHPUnit, el fallo
                    // ya lo da `make test`; aquí no se agrega un segundo error engañoso.
                    junit testResults: 'microservicios/gestion-departamentos/reports/junit.xml', allowEmptyResults: true
                    recordCoverage(
                        tools: [[parser: 'CLOVER', pattern: 'microservicios/gestion-departamentos/reports/clover.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                    )
                }
            }
        }

        // SonarQube: importa la cobertura y los resultados de Test. Las exclusiones de cobertura
        // son las mismas de phpunit.xml (conexión por entorno y carga de archivos).
        // SONAR_HABILITADO=false salta ambos stages.
        stage('SonarQube') {
            when { environment name: 'SONAR_HABILITADO', value: 'true' }
            steps {
                dir(env.SERVICE_DIR) {
                    withSonarQubeEnv('SonarQubeServer') {
                        sh '''
                        sonar-scanner \\
                          -Dsonar.projectKey=gestion-departamentos \\
                          -Dsonar.sources=src \\
                          -Dsonar.tests=tests \\
                          -Dsonar.coverage.exclusions=src/Database.php,src/cargar.php \\
                          -Dsonar.php.coverage.reportPaths=reports/clover.xml \\
                          -Dsonar.php.tests.reportPath=reports/junit.xml
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { environment name: 'SONAR_HABILITADO', value: 'true' }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                sh "docker build -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest ${SERVICE_DIR}"
            }
        }

        stage('Publish') {
            steps {
                sh "docker push ${IMAGE}:${BUILD_NUMBER}"
                sh "docker push ${IMAGE}:latest"
            }
        }
    }
}
