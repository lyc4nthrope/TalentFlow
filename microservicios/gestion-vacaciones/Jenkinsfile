pipeline {
    agent any

    environment {
        SERVICE_NAME = "gestion-vacaciones"
        REGISTRY  = "${env.REGISTRY_URL ?: 'localhost:5000'}"
        SONAR_URL = "${env.SONAR_HOST_URL ?: 'http://sonarqube:9000'}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build') {
            steps {
                dir('microservicios/gestion-vacaciones') {
                    echo 'Compilando el proyecto...'
                    sh 'mvn clean compile -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/gestion-vacaciones') {
                    echo 'Ejecutando pruebas unitarias e integración con JaCoCo...'
                    sh 'mvn verify -Dmaven.test.failure.ignore=true'
                }
            }

            post {
                always {
                    dir('microservicios/gestion-vacaciones') {
                        junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml, target/failsafe-reports/*.xml'
                        recordCoverage(
                            tools: [[parser: 'JACOCO', pattern: 'target/site/jacoco/jacoco.xml']],
                            sourceCodeRetention: 'EVERY_BUILD'
                        )
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('microservicios/gestion-vacaciones') {
                    echo 'Ejecutando análisis de SonarQube...'
                    withSonarQubeEnv('SonarQubeServer') { 
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.host.url=${SONAR_HOST_URL}
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('microservicios/gestion-vacaciones') {
                    sh "docker build -t ${SERVICE_NAME}:${BUILD_NUMBER} -t ${SERVICE_NAME}:latest ."
                    echo "✅ Imagen construida: ${SERVICE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('Publish') {
            steps {
                sh """
                    docker tag ${SERVICE_NAME}:${BUILD_NUMBER} ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}
                    docker tag ${SERVICE_NAME}:${BUILD_NUMBER} ${REGISTRY}/${SERVICE_NAME}:latest
                    docker push ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}
                    docker push ${REGISTRY}/${SERVICE_NAME}:latest
                """
                echo "📤 Imagen publicada en registry: ${REGISTRY}/${SERVICE_NAME}:${BUILD_NUMBER}"
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ El código compiló pero hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de compilación o fallo en la ejecución de Maven.'
        }
    }
}