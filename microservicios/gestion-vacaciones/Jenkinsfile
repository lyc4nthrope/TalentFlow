pipeline {
    // Usamos un contenedor de Maven con JDK 17
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-17'
            // Monta volumen para la caché local de Maven (.m2)
            args '-v maven_cache:/root/.m2'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build') {
            steps {
                dir('microservicios/gestion-vacaciones') {
                    echo 'Compilando el proyecto...'
                    sh 'mvn clean compile -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('microservicios/gestion-vacaciones') {
                    echo 'Ejecutando pruebas unitarias e integración con JaCoCo...'
                    // -Dmaven.test.failure.ignore=true evita que el comando aborte de inmediato
                    // para permitir que el bloque post publique los reportes JUnit y JaCoCo
                    sh 'mvn verify -Dmaven.test.failure.ignore=true'
                }
            }

            post {
                always {
                    dir('microservicios/gestion-vacaciones') {
                        // 1. Publica los resultados en la pestaña "Test Result"
                        junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml, target/failsafe-reports/*.xml'

                        // 2. Publica la cobertura usando el parser JACOCO
                        recordCoverage(
                        tools: [[parser: 'JACOCO', pattern: 'target/site/jacoco/jacoco.xml']],
                        sourceCodeRetention: 'EVERY_BUILD'
                        )
                    }
                }
            }
        }

        stage('SonarQube') {
            environment {
                SONAR_TOKEN = credentials('sonarqube-token')
            }

            steps{
                dir('microservicios/gestion-vacaciones'){
                    sh """
                    mvn sonar:sonar \
                    -Dsonar.host.url=http://sonarqube:9000 \
                    -Dsonar.token=${SONAR_TOKEN}
                    """
                }
            }
        }
        stage('Quality Gate') {
        steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ El código compiló pero hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error de compilación o fallo en la ejecución de Maven.'
        }
    }
}