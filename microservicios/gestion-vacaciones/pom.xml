<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.talentflow</groupId>
    <artifactId>gestion-vacaciones</artifactId>
    <version>1.0.0</version>
    <name>gestion-vacaciones</name>
    <description>Servicio de Gestión de Vacaciones (Reto 4, TalentFlow)</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.9.1</springdoc.version>
        <jacoco.version>0.8.14</jacoco.version>
    </properties>

    <dependencies>
        <!-- REST + validación de entrada -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Persistencia con SQL explícito (JdbcClient): control total de las
             transacciones de deduplicación y de ON CONFLICT -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- RabbitMQ (Spring AMQP) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- Reto 8 (D5): métricas en /actuator/prometheus; versiones gestionadas por Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Generación de la especificación OpenAPI (la UI se sirve aparte, bajo /vacaciones/docs) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reto 6 (D8): pruebas de integración contra PostgreSQL 16 real (versiones del BOM de Spring Boot) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gestion-vacaciones</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Reto 6 (D9): reports/ se vacía al comienzo de cada build. Si no, un mvn test
                 dejaría los TEST-*IT.xml de un verify anterior y el pipeline los publicaría
                 como si fueran de esta ejecución. Solo borra reports/, no target/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>limpiar-reportes</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.basedir}/reports</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Reto 6 (D9): un TEST-*.xml por clase de prueba en reports/junit -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reportsDirectory>${project.basedir}/reports/junit</reportsDirectory>
                    <!-- Agente de JaCoCo de las unitarias (target/jacoco.exec) -->
                    <argLine>@{jacocoUnitarias}</argLine>
                    <!-- Las *IT necesitan Docker: solo las corre Failsafe (mvn verify) -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <!-- El XML usa el nombre visible: cada fila de una tabla de casos
                         (@ParameterizedTest) aparece con su descripción, no solo con [n]. -->
                    <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                </configuration>
            </plugin>
            <!-- Reto 6 (D8): pruebas de integración (*IT) con Testcontainers en integration-test/verify.
                 Sus TEST-*IT.xml van al mismo reports/junit que las unitarias: un solo patrón para el pipeline. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <reportsDirectory>${project.basedir}/reports/junit</reportsDirectory>
                    <!-- Agente aparte (target/jacoco-it.exec): no pisa la cobertura de las unitarias -->
                    <argLine>@{jacocoIntegracion}</argLine>
                    <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Reto 6 (D11, D14): cobertura de la lógica de negocio (dominio y aplicacion).
                 Arranque, configuración e infraestructura quedan fuera de la medición; la
                 persistencia se prueba en integración (F2). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <!-- Las exclusiones (D11) van en report y check, no a nivel del plugin: ahí también
                     las tomaría el agente y no instrumentaría la persistencia que miden las *IT. -->
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoUnitarias</propertyName>
                            <!-- Por defecto el agente acumula en target/jacoco.exec entre ejecuciones:
                                 sin esto, una prueba borrada seguiría "cubriendo" desde la corrida anterior. -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoIntegracion</propertyName>
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/reports/coverage</outputDirectory>
                            <excludes>
                                <exclude>com/talentflow/vacaciones/infraestructura/**</exclude>
                                <exclude>com/talentflow/vacaciones/Configuracion*</exclude>
                                <exclude>com/talentflow/vacaciones/VacacionesApplication*</exclude>
                            </excludes>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                            </formats>
                        </configuration>
                    </execution>
                    <!-- Informativo, sin umbral: qué de la persistencia ejercitan las *IT -->
                    <execution>
                        <id>report-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/reports/coverage-integracion</outputDirectory>
                            <includes>
                                <include>com/talentflow/vacaciones/infraestructura/persistencia/**</include>
                            </includes>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                            </formats>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/talentflow/vacaciones/infraestructura/**</exclude>
                                <exclude>com/talentflow/vacaciones/Configuracion*</exclude>
                                <exclude>com/talentflow/vacaciones/VacacionesApplication*</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.talentflow.vacaciones.dominio</include>
                                        <include>com.talentflow.vacaciones.aplicacion</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
