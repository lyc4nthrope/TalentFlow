pipeline {
    // Usamos una imagen oficial de Python de Docker
    agent {
        docker {
            image 'python:3.11-slim'
            // Monta volumen para la caché de pip
            args '-v pip_cache:/root/.cache/pip'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo código del repositorio...'
            }
        }

        stage('Build') {
            steps {
                dir('microservicios/gestion-perfiles') {
                    echo 'Instalando dependencias de Python y herramientas...'
                    sh '''
                        apt-get update && apt-get install -y default-jre-headless curl unzip
                        pip install --upgrade pip
                        pip install -r requirements.txt pytest pytest-cov httpx
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                // Se agrega dir para ejecutar pytest dentro de la carpeta del microservicio
                dir('microservicios/gestion-perfiles') {
                    echo 'Ejecutando pruebas unitarias con Pytest y generando reportes...'
                    sh 'pytest --junitxml=reports/junit.xml --cov=. --cov-report=xml:reports/coverage.xml || true'
                }
            }

            post {
                always {
                    dir('microservicios/gestion-perfiles') {
                        // 1. Publica las pruebas en la pestaña "Test Result"
                        junit allowEmptyResults: true, testResults: 'reports/junit.xml'

                        // 2. Publica la cobertura usando el parser COBERTURA
                        recordCoverage(
                            tools: [[parser: 'COBERTURA', pattern: 'reports/coverage.xml']],
                            sourceCodeRetention: 'EVERY_BUILD'
                        )
                    }
                }
            }
        }

        stage('SonarQube') {
            environment {
                SONAR_TOKEN = credentials('sonarqube-token')
            }
            steps {
                dir('microservicios/gestion-perfiles') {
                    echo 'Descargando y ejecutando SonarScanner (ARM64 / JVM nativo)...'
                    withSonarQubeEnv('SonarQubeServer') {
                        sh '''
                            if [ ! -d "/tmp/sonar-scanner" ]; then
                            curl -sSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006.zip
                            unzip -q /tmp/sonar-scanner.zip -d /tmp/
                            mv /tmp/sonar-scanner-5.0.1.3006 /tmp/sonar-scanner
                            fi
                            
                            /tmp/sonar-scanner/bin/sonar-scanner \
                            -Dsonar.host.url=http://host.docker.internal:9000 \
                            -Dsonar.token=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }


    }

    post {
        success {
            echo '✅ Pipeline finalizado con éxito.'
        }
        unstable {
            echo '⚠️ Hay pruebas fallando. Revisa la pestaña Test Result.'
        }
        failure {
            echo '❌ Error en la instalación o ejecución en Python.'
        }
    }
}