{
  "uid": "talentflow-observabilidad",
  "title": "TalentFlow - Observabilidad",
  "description": "Reto 8: salud, tráfico, latencia, errores y recursos de los 7 microservicios.",
  "tags": [
    "talentflow",
    "reto8"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "title": "Resumen del sistema",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Estado de cada servicio",
      "description": "up de cada scrape_job de los servicios (sin las sondas del job dependencias): 1 = Prometheus llegó a /metrics en el último scrape (UP), 0 = no (DOWN).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "up{job!~\"prometheus|dependencias\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Salud por servicio (proceso, base de datos y lo que reporta el servicio)",
      "description": "Una fila por microservicio (D22). Proceso = up de su scrape. Base de datos (sonda directa) = conexión TCP del Blackbox Exporter, independiente del servicio. Las dos columnas \"según el servicio\" son su propio /health leído por el Gateway: SIN DATOS ahí significa que el servicio no responde. NO USA = el servicio no tiene broker.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 20,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                },
                "-1": {
                  "text": "NO USA",
                  "color": "transparent",
                  "index": 2
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "SIN DATOS",
                  "color": "#808080",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#808080"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#808080",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Servicio"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "mappings",
                "value": []
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Microservicio (proceso)"
            },
            "properties": [
              {
                "id": "description",
                "value": "up del scrape de /metrics: ¿el proceso responde a Prometheus?"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Base de datos (sonda directa)"
            },
            "properties": [
              {
                "id": "description",
                "value": "probe_success del Blackbox Exporter: ¿la BD acepta conexiones TCP? No depende del servicio."
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Base de datos (según el servicio)"
            },
            "properties": [
              {
                "id": "description",
                "value": "check database del /health del servicio. SIN DATOS = el servicio no responde."
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Broker (según el servicio)"
            },
            "properties": [
              {
                "id": "description",
                "value": "check messageBroker del /health del servicio. SIN DATOS = el servicio no responde; NO USA = el servicio no usa broker."
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Servicio",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (service) (label_replace(up{job=~\".+-service\"}, \"service\", \"$1\", \"job\", \"(.+)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (service) (probe_success{job=\"dependencias\", check=\"database\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (service) (talentflow_health_check{check=\"database\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "max by (service) (talentflow_health_check{check=\"messageBroker\"}) or (max by (service) (talentflow_health_check{check=\"database\"}) * 0 - 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "service": "Servicio",
              "Value #A": "Microservicio (proceso)",
              "Value #B": "Base de datos (sonda directa)",
              "Value #C": "Base de datos (según el servicio)",
              "Value #D": "Broker (según el servicio)"
            }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Broker (sonda directa)",
      "description": "probe_success del Blackbox Exporter contra message-broker:5672 (AMQP): 1 = RabbitMQ acepta conexiones, 0 = no. Independiente de los servicios.",
