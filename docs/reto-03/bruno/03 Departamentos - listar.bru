meta {
  name: 03 Departamentos - listar
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/departamentos
  body: none
  auth: none
}

tests {
  test("200 con un arreglo que incluye IT", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().map((d) => d.id)).to.include("IT");
  });
}
