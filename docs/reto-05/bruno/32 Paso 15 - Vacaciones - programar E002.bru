meta {
  name: Paso 15 - Vacaciones - programar E002
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/vacaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "empleadoId": "{{e2}}",
    "fechaInicio": "{{inicio2}}",
    "fechaFin": "{{fin2}}"
  }
}

script:pre-request {
  // Desviación del PDF (fechaInicio = fechaFin = hoy): con fecha sola el fin sería las 23:59:59 (D6).
  // Se usan fecha y hora reales de hoy en America/Bogota (UTC-5, sin horario de verano):
  // inicio en el próximo minuto exacto a 20 s o más de ahora y fin 120 s después.
  const bogota = (ms) => new Date(ms - 5 * 3600000).toISOString().slice(0, 19);
  const inicio = Math.ceil((Date.now() + 20000) / 60000) * 60000;
  const fin = inicio + 120 * 1000;
  bru.setVar("inicio2Ms", String(inicio));
  bru.setVar("fin2Ms", String(fin));
  bru.setVar("inicio2", bogota(inicio));
  bru.setVar("fin2", bogota(fin));
}

tests {
  test("201 PROGRAMADA", function () {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("vac2", res.getBody().id);
  });
}

docs {
  Caso borde: 2 minutos de vacaciones para que dé tiempo de retirar al empleado mientras están en curso.
}
