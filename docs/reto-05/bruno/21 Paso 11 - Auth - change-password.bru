meta {
  name: Paso 11 - Auth - change-password
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{passRecuperada}}",
    "newPassword": "{{passNueva}}"
  }
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
