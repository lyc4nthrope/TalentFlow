meta {
  name: Paso 15 - Vacaciones - E002 finalizadas
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/vacaciones/{{vac2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  // El scheduler corre cada minuto (VACACIONES_CRON) y el período empieza/termina en un minuto exacto:
  // se espera hasta ese instante más 8 s para que el evento recorra el broker.
  const espera = Number(bru.getVar("fin2Ms")) + 8000 - Date.now();
  if (espera > 0) await bru.sleep(espera);
}

tests {
  test("FINALIZADA (se publicó vacaciones.finalizadas)", function () {
    expect(res.getBody().estado).to.equal("FINALIZADA");
  });
}

docs {
  Evidencia en el log de auth-service (D5):

  ```
  docker compose logs auth-service | grep "no se reactiva"
  # auth-service: cuenta retirada: no se reactiva (empleado <id>, vacaciones <vacacionesId>)
  ```
}
