meta {
  name: Paso 14 - Notificaciones - bienvenida de regreso
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/notificaciones/{{e1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("CUENTA: Bienvenido de regreso (cuenta.activada, motivo FIN_VACACIONES)", function () {
    const n = res.getBody().find((x) => x.tipo === "CUENTA" && x.mensaje.includes("Bienvenido de regreso"));
    expect(n).to.not.equal(undefined);
  });
}
