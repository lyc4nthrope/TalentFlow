meta {
  name: Paso 08 - Auth - reset-password con el token de recuperación
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{tokenRecuperacion}}",
    "newPassword": "{{passRecuperada}}"
  }
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
