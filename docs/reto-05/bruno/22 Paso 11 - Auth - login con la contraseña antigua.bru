meta {
  name: Paso 11 - Auth - login con la contraseña antigua
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email1}}",
    "password": "{{passRecuperada}}"
  }
}

tests {
  test("401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
