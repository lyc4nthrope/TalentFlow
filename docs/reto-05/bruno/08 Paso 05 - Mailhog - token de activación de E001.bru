meta {
  name: Paso 05 - Mailhog - token de activación de E001
  type: http
  seq: 8
}

get {
  url: {{mailhogUrl}}/api/v2/search?kind=to&query={{email1}}
  body: none
  auth: none
}

script:pre-request {
  await bru.sleep(1000);
}

tests {
  // Mailhog devuelve los correos del más reciente al más antiguo. El cuerpo viaja en
  // quoted-printable: se quitan los saltos suaves ("=\r\n") antes de buscar el token.
  function tokenDe(items, filtro) {
    for (const m of items) {
      const cuerpo = m.Content.Body.replace(/=\r?\n/g, "");
      const t = cuerpo.match(/use el token ([0-9a-f-]{36})/);
      if (t && filtro(cuerpo)) return t[1];
    }
    return null;
  }
  test("el correo de bienvenida trae el token de activación", function () {
    const t = tokenDe(res.getBody().items, (c) => c.includes("Bienvenido"));
    expect(t).to.not.equal(null);
    bru.setVar("tokenActivacion1", t);
  });
}

docs {
  El PDF pide extraer el token "de los logs de la notificación". Bruno no puede leer los logs:
  lo toma del correo que recibió Mailhog, que tiene exactamente el mismo texto que la línea
  `[NOTIFICACIÓN]` del log (`docker compose logs notificaciones-service | grep "Para: <email>"`).
}
