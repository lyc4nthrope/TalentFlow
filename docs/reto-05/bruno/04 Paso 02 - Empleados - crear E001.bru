meta {
  name: Paso 02 - Empleados - crear E001
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/empleados
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{e1}}",
    "nombre": "Juan",
    "apellido": "Pérez",
    "email": "{{email1}}",
    "numeroEmpleado": "{{numero1}}",
    "cargo": "Desarrollador",
    "area": "Tecnología",
    "departamentoId": "IT",
    "fechaIngreso": "2026-03-01"
  }
}

tests {
  test("201 con Location (publica empleado.creado)", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("location")).to.equal("/empleados/" + bru.getVar("e1"));
  });
}
