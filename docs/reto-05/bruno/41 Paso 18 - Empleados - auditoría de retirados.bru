get {
  url: {{baseUrl}}/empleados?estado=RETIRADO
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("lista a E001 con su fechaRetiro", function () {
    expect(res.getStatus()).to.equal(200);
    const e = res.getBody().find((x) => x.id === bru.getVar("e1"));
    expect(e).to.not.equal(undefined);
    expect(e.fechaRetiro).to.be.a("string");
  });
}
