meta {
  name: Paso 06 - Auth - login de E001
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email1}}",
    "password": "{{passInicial}}"
  }
}

tests {
  // Claims del JWT (sin verificar la firma; solo para mostrarlos). Decodificación base64url a mano:
  // el sandbox seguro de Bruno no tiene Buffer ni atob.
  function claimsDe(jwt) {
    const abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    let bits = "";
    let texto = "";
    for (const c of jwt.split(".")[1]) bits += abc.indexOf(c).toString(2).padStart(6, "0");
    for (let i = 0; i + 8 <= bits.length; i += 8) texto += String.fromCharCode(parseInt(bits.slice(i, i + 8), 2));
    return JSON.parse(texto);
  }
  test("200 con un JWT de rol USER y sub = empleadoId", function () {
    expect(res.getStatus()).to.equal(200);
    bru.setVar("userToken", res.getBody().token);
    const claims = claimsDe(res.getBody().token);
    expect(claims.role).to.equal("USER");
    expect(claims.sub).to.equal(bru.getVar("e1"));
  });
}
