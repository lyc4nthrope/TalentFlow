meta {
  name: Notificaciones - bienvenida
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/notificaciones/{{empleadoId}}
  body: none
  auth: none
}

tests {
  test("se registró la notificación BIENVENIDA", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().map((n) => n.tipo)).to.include("BIENVENIDA");
  });
}
