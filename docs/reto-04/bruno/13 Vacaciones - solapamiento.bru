meta {
  name: Vacaciones - solapamiento
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/vacaciones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "empleadoId": "{{empleadoId}}",
    "fechaInicio": "{{vacCruce}}",
    "fechaFin": "{{vacCruceFin}}"
  }
}

tests {
  test("400 con el período en conflicto", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().periodoEnConflicto.id).to.equal(bru.getVar("vacacionesId"));
  });
}
