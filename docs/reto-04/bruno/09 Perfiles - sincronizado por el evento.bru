meta {
  name: Perfiles - sincronizado por el evento
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/perfiles/{{empleadoId}}
  body: none
  auth: none
}

script:pre-request {
  // La reacción al evento es asincrónica: se espera a que el consumidor la procese.
  await bru.sleep(2500);
}

tests {
  test("nombre sincronizado sin tocar los datos propios del perfil", function () {
    expect(res.getBody().nombre).to.equal("Juan Pérez Gómez");
    expect(res.getBody().telefono).to.equal("3001234567");
  });
}
