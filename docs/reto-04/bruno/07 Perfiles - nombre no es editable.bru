meta {
  name: Perfiles - nombre no es editable
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/perfiles/{{empleadoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Otro"
  }
}

tests {
  test("400: nombre se replica desde empleados", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errors[0].field).to.equal("nombre");
  });
}
