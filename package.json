{
  "name": "talentflow",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de onboarding y offboarding de empleados basado en microservicios",
  "workspaces": [
    "shared",
    "microservicios/*"
  ],
  "scripts": {
    "dev:empleados": "npm run dev --workspace=@talentflow/gestion-empleados",
    "start:empleados": "npm run start --workspace=@talentflow/gestion-empleados",
    "test": "npm run test --workspaces --if-present"
  }
}
